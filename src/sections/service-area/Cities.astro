---
// Service area: map + "Cities we paint in" (copy doc PAGE 7). City chips styled like the homepage chips (9:57).
// One page on purpose: no separate city pages (doorway-page risk, see copy doc notes).
import Section from '../../components/inner/Section.astro';
import AreaMap from './AreaMap.astro';
import { PHONE_DISPLAY, PHONE_TEL } from '../../data/site';
const groups: [string, string[]][] = [
  ['Washington County:', ['Hillsboro', 'Beaverton', 'Aloha', 'Tigard', 'Tualatin', 'Sherwood', 'Forest Grove', 'Cornelius', 'North Plains', 'Banks']],
  ['Portland and nearby:', ['Portland', 'Lake Oswego', 'West Linn', 'Wilsonville']],
  ['Yamhill County:', ['Newberg']],
];
---
<Section bg="white" id="cities" title="Cities we paint in">
  <div class="grid gap-[40px] lg:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)] lg:gap-[72px] lg:items-center">
    <AreaMap />
    <div class="flex flex-col gap-[28px] lg:gap-[32px] min-w-0">
      {groups.map(([label, cities]) => (
        <div class="flex flex-col gap-[12px]">
          <h3 class="tm-step lg:t-display-xs text-ink">{label}</h3>
          <ul class="flex flex-wrap gap-[8px]">
            {cities.map((c) => (
              <li class="bg-primer border border-mist px-[14px] py-[8px] rounded-[40px] t-body-s text-ink whitespace-nowrap">{c}</li>
            ))}
          </ul>
        </div>
      ))}
      <p class="t-body-m text-ink">Don't see your town? If you're within about 50 miles of Hillsboro, we can probably get to you. Call <a href={PHONE_TEL} class="t-button text-forest hover:text-forest-dark whitespace-nowrap">{PHONE_DISPLAY}</a> and ask.</p>
    </div>
  </div>
</Section>
