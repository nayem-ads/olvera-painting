---
// Larger version of the homepage map (Figma 9:65). The frame here is the Oregon outline's own box
// (oregon-desktop.svg viewBox 589.6×420.2), so every Figma position is shifted by the outline's offset
// (19.82, 21.6) and expressed in % of that box. Labels scale with the map through container query units.
const W = 589.6, H = 420.2, OX = 19.82, OY = 21.6;
const pos = (x: number, y: number, w?: number, h?: number) =>
  `left:${(((x - OX) / W) * 100).toFixed(3)}%;top:${(((y - OY) / H) * 100).toFixed(3)}%` +
  (w ? `;width:${((w / W) * 100).toFixed(3)}%;height:${(((h ?? w) / H) * 100).toFixed(3)}%` : '');
const dots: [number, number][] = [[155.44, 90.68], [134.56, 112.06], [124.48, 90.68]];
---
<div class="op-area-map" role="img" aria-label="Map of Oregon with a circle marking about 50 miles around Hillsboro, where Olvera Painting is based">
  <img src="/svg/oregon-desktop.svg" alt="" width="589.6" height="420.2" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full" />
  <img src="/img/radius-desktop-140.webp" alt="" width="140" height="140" loading="lazy" decoding="async" class="absolute" style={pos(67.12, 24.68, 140)} />
  {dots.map(([x, y]) => <img src="/svg/dot-desktop.svg" alt="" width="8" height="8" loading="lazy" class="absolute" style={pos(x, y, 8)} />)}
  <img src="/svg/pin-desktop.svg" alt="" width="18" height="18" loading="lazy" class="absolute" style={pos(128.12, 85.68, 18)} />
  <span aria-hidden="true" class="op-area-label absolute bg-evergreen text-white rounded-[3px]" style={pos(153.12, 50.68)}>HILLSBORO · HQ</span>
  <span aria-hidden="true" class="op-area-label op-area-label--light absolute bg-white text-forest rounded-[3px]" style={pos(93.12, 172.68)}>≈ 50 MILES</span>
</div>

<style>
  .op-area-map { position: relative; width: 100%; aspect-ratio: 589.6 / 420.2; container-type: inline-size; }
  /* Figma: Barlow Condensed SemiBold 14/18, ls 2.4, padding 5/10 (dark) and 3/8 (light) at 589.6 wide. */
  .op-area-label {
    font-family: var(--font-label); font-weight: 600; white-space: nowrap;
    font-size: clamp(10px, 2.3745cqw, 17px); line-height: 1.2857; letter-spacing: 0.1714em;
    padding: 0.357em 0.714em;
  }
  .op-area-label--light { padding: 0.214em 0.571em; }
</style>
