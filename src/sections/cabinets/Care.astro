<Section id="cabinet-care" bg="white" eyebrow="AFTER THE JOB" title="Living with freshly painted cabinets">
  <div class="grid gap-[28px] lg:grid-cols-[minmax(0,1fr)_minmax(0,520px)] lg:gap-[80px] lg:items-center">
