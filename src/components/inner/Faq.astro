---
// FAQ accordion: native <details>/<summary> (keyboard: Tab to a question, Enter/Space toggles). Also emits FAQPage JSON-LD via the page.
interface Props { items: [string, string][] }
const { items } = Astro.props;
---
<div class="flex flex-col border-t border-mist">
  {items.map(([q, a]) => (
    <details class="group border-b border-mist">
      <summary class="flex items-center justify-between gap-[16px] py-[18px] lg:py-[22px] cursor-pointer list-none [&::-webkit-details-marker]:hidden">
        <h3 class="tm-step lg:t-display-xs text-ink">{q}</h3>
        <span aria-hidden="true" class="shrink-0 w-[32px] h-[32px] rounded-full bg-primer border border-mist grid place-items-center text-forest t-button transition-transform group-open:rotate-45">+</span>
      </summary>
      <p class="pb-[20px] lg:pb-[24px] pr-[48px] t-body-s lg:t-body-m text-muted">{a}</p>
    </details>
  ))}
</div>
