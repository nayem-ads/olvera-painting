---
// Inner-page section wrapper + optional heading. bg: white | primer | evergreen. Spacing matches homepage sections, a bit tighter.
interface Props { bg?: 'white' | 'primer' | 'evergreen'; eyebrow?: string; title?: string; intro?: string; id?: string; class?: string; narrow?: boolean }
const { bg = 'white', eyebrow, title, intro, id, class: cls = '', narrow = false } = Astro.props;
const dark = bg === 'evergreen';
const hid = id ? `${id}-title` : undefined;
---
<section id={id} aria-labelledby={title ? hid : undefined} class={{ white: 'bg-white', primer: 'bg-primer', evergreen: 'bg-evergreen text-white' }[bg]}>
  <div class={`mx-auto max-w-[1440px] px-[20px] lg:px-[96px] py-[56px] lg:py-[96px] ${cls}`}>
    <div class={narrow ? 'max-w-[820px]' : ''}>
      {(eyebrow || title) && (
        <div class="flex flex-col gap-[8px] lg:gap-[10px] mb-[24px] lg:mb-[40px]">
          {eyebrow && <p class={`tm-eyebrow lg:t-eyebrow ${dark ? 'text-forest-light' : 'text-forest'}`}>{eyebrow}</p>}
          {title && <h2 id={hid} class={`tm-h2 lg:t-display-m ${dark ? 'text-white' : 'text-ink'}`}>{title}</h2>}
          {intro && <p class={`t-body-m lg:t-body-l max-w-[760px] ${dark ? 'text-white/80' : 'text-muted'}`}>{intro}</p>}
        </div>
      )}
      <slot />
    </div>
  </div>
</section>
