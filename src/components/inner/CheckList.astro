---
// Bulleted list with small forest squares (paint-chip marker). cols=2 splits into two columns on desktop.
interface Props { items: string[]; cols?: 1 | 2; dark?: boolean }
const { items, cols = 1, dark = false } = Astro.props;
---
<ul class={`grid gap-x-[40px] gap-y-[12px] lg:gap-y-[14px] ${cols === 2 ? 'lg:grid-cols-2' : ''}`}>
  {items.map((t) => (
    <li class={`flex gap-[14px] items-start t-body-m ${dark ? 'text-white/85' : 'text-ink'}`}>
      <span aria-hidden="true" class="mt-[9px] shrink-0 w-[10px] h-[10px] bg-forest rotate-[4deg]"></span><span>{t}</span>
    </li>
  ))}
</ul>
