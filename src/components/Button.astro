---
// Buttons from the homepage design. All sizes/colours from Figma frame 5:3 / 11:2.
// variant: solid (forest), outline-light (white 55% border, on dark), outline-dark (ink border), white (on forest), outline-white (white 70% border, on forest), outline-forest (mobile call bar)
// Pass padding/width classes per placement via class. Arrow glyph copy comes from Figma ("Get my free estimate  →").
interface Props { href: string; variant?: 'solid'|'outline-light'|'outline-dark'|'white'|'outline-white'|'outline-forest'; class?: string; dataNode?: string; dataNodeM?: string; label?: string; type?: 'submit'|'button' }
const { href, variant = 'solid', class: cls = '', dataNode, dataNodeM, label, type } = Astro.props;
const v = {
  'solid': 'bg-forest text-white hover:bg-forest-dark',
  'outline-light': 'border-[1.5px] border-[rgba(255,255,255,0.55)] text-white hover:bg-white/10 hover:border-white',
  'outline-dark': 'border-[1.5px] border-ink text-ink hover:bg-ink hover:text-white',
  'white': 'bg-white text-forest-dark hover:bg-primer',
  'outline-white': 'border-[1.5px] border-[rgba(255,255,255,0.7)] text-white hover:bg-white/10 hover:border-white',
  'outline-forest': 'border-[1.5px] border-forest text-forest hover:bg-forest hover:text-white',
}[variant];
const base = `inline-flex items-center justify-center rounded-[6px] t-button whitespace-pre transition-colors duration-150 ${v} ${cls}`;
---
{type ? (
  <button type={type} class={base} data-node={dataNode} data-node-m={dataNodeM} aria-label={label}><slot /></button>
) : (
  <a href={href} class={base} data-node={dataNode} data-node-m={dataNodeM} aria-label={label}><slot /></a>
)}
